{
  "$schema": "https://schema.tauri.app/config/2/capability",
  "identifier": "default",
  "description": "Default Jarvis desktop capabilities",
  "windows": [
    "main"
  ],
  "remote": {
    "urls": [
      "http://127.0.0.1:4780/*",
      "http://localhost:4780/*"
    ]
  },
  "permissions": [
    "core:default",
    "shell:allow-open",
    "autostart:allow-enable",
    "autostart:allow-disable",
    "autostart:allow-is-enabled",
    "allow-app-version",
    "allow-backend-status",
    "allow-minimize-window",
    "allow-show-window",
    "allow-hide-window",
    "allow-start-backend",
    "allow-stop-backend",
    "allow-restart-backend",
    "allow-open-logs",
    "allow-set-autostart",
    "allow-get-autostart",
    "allow-set-close-to-tray",
    "allow-quit-jarvis",
    "allow-quit-manager",
    "allow-data-paths",
    "allow-obsidian-probe",
    "allow-obsidian-bound-vault-path",
    "allow-obsidian-embed-start",
    "allow-obsidian-embed-resize",
    "allow-obsidian-embed-stop",
    "allow-obsidian-focus-note",
    "allow-obsidian-open-install"
  ]
}

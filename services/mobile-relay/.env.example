# Copy to .env beside compose.yaml on the relay host (never commit real values).
# Required for docker compose up:
RELAY_HOSTNAME=relay.example.com
RELAY_REGISTRATION_CODE=generate-a-long-random-operator-code
FIREBASE_CREDENTIAL_FILE=/path/on/host/to/firebase-service-account.json

# TURN shared-secret authentication; use a unique high-entropy value per relay.
# It belongs only in the relay host environment and the Jarvis gateway secret store.
TURN_SHARED_SECRET=generate-a-long-random-turn-secret
TURN_REALM=relay.example.com

# Optional: relay SQLite and listener state (default inside the container is /data)
# RELAY_DATA=/var/lib/jarvis-relay

# Public ports (see compose.yaml):
#   TCP 80/443  — Caddy HTTPS for /v1/register, /v1/push, relay WebSocket control
#   TCP 15000-15099 — opaque TCP tunnels (one port per registered Jarvis swarm)
# Development Compose overlay also exposes: UDP/TCP 3478 and UDP 49160-49200 for TURN.

# Copy to .env or set in the user environment. Never commit real tokens.
# JARVIS_AUTH_TOKEN=  # 16+ characters required to enable LAN bind
# JARVIS_BIND_HOST=127.0.0.1
# JARVIS_BIND_PORT=4780
# JARVIS_SKIP_MODEL=1
# JARVIS_INFERENCE_BACKEND=llama.cpp
# JARVIS_INFERENCE_HOST=127.0.0.1
# JARVIS_INFERENCE_PORT=8088
# JARVIS_INFERENCE_BASE_URL=  # e.g. http://192.168.1.50:8080/v1
# JARVIS_INFERENCE_MODEL=Qwen3.5-9B-Abliterated
# JARVIS_INFERENCE_API_KEY=  # never stored in settings.json
# JARVIS_WHISPER_MODEL=tiny.en
# JARVIS_WHISPER_DEVICE=cpu
# JARVIS_PIPER_BIN=
# JARVIS_PIPER_VOICE=

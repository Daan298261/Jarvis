# Jarvis desktop / service environment for Android companion remote access.
# Copy values into your operator secret store or OS env — do not commit filled-in files.

# Off-network phone access is Tailscale only (docs/rfcs/0215-remote-companion-pairing.md).

# --- FCM push broker (operator-hosted) ---
JARVIS_PUSH_URL=https://push.example.com/v1/push
JARVIS_PUSH_CREDENTIAL=

# --- WebRTC TURN (coturn with REST shared-secret; separate from the relay) ---
JARVIS_TURN_URL=turn:turn.example.com:3478?transport=udp
JARVIS_TURN_SECRET=

# --- Firebase Android client config (public fields only; path to JSON on the Jarvis PC) ---
# Used when building a personalized APK — never put the Firebase admin service account here.
JARVIS_FIREBASE_CLIENT_CONFIG=/path/on/jarvis-pc/firebase-android-client.json

# Example firebase-android-client.json shape (download from Firebase console → Project settings → Your apps):
# {
#   "app_id": "...",
#   "api_key": "...",
#   "project_id": "...",
#   "sender_id": "..."
# }
